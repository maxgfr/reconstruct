{
  "name": "reconstruct",
  "version": "1.2.2",
  "description": "Analyze any repository and generate reconstruction PRDs to rebuild a project from scratch. A skills.sh agent skill.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "reconstruct": "scripts/analyze.mjs"
  },
  "files": [
    "skills",
    "scripts",
    "assets",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "verify:bundle": "node scripts/verify-skill-bundle.mjs",
    "check:build": "tsup && node scripts/copy-bundle.mjs && git diff --exit-code -- scripts/analyze.mjs skills/reconstruct/scripts/analyze.mjs && node scripts/verify-skill-bundle.mjs",
    "demo": "node scripts/analyze.mjs --repo tests/fixtures/sample-app --out /tmp/reconstruct-demo --mode preserve --level light",
    "demo:scratch": "node scripts/analyze.mjs --scratch --plan tests/fixtures/scratch-plan/example.plan.json --out /tmp/reconstruct-scratch-demo --level complex",
    "parity": "node scripts/parity.mjs --plan tests/fixtures/scratch-plan/example.plan.json",
    "release": "semantic-release"
  },
  "keywords": [
    "skills",
    "agent-skill",
    "skills.sh",
    "prd",
    "reconstruct",
    "reverse-engineering",
    "codegen",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "maxgfr",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxgfr/reconstruct"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.14.0",
    "semantic-release": "^24.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
