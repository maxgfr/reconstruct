{
  "name": "reconstruct",
  "version": "0.6.3",
  "description": "Analyze any repository and generate reconstruction PRDs to rebuild a project from scratch. A skills.sh agent skill.",
  "type": "module",
  "bin": {
    "reconstruct": "scripts/analyze.mjs"
  },
  "files": [
    "SKILL.md",
    "scripts",
    "references",
    "assets",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:build": "tsup && git diff --exit-code -- scripts/analyze.mjs",
    "demo": "node scripts/analyze.mjs --repo tests/fixtures/sample-app --out /tmp/reconstruct-demo --mode preserve --level light",
    "demo:scratch": "node scripts/analyze.mjs --scratch --plan tests/fixtures/scratch-plan/medic.plan.json --out /tmp/reconstruct-scratch-demo --level complex",
    "parity": "node scripts/parity.mjs --plan tests/fixtures/scratch-plan/medic.plan.json"
  },
  "keywords": [
    "skills",
    "agent-skill",
    "skills.sh",
    "prd",
    "reconstruct",
    "reverse-engineering",
    "codegen",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "maxgfr",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxgfr/reconstruct"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
